{
  "name": "vrpc",
  "version": "3.18.0",
  "description": "Remote objects over MQTT: call classes in other programs as if they were local - Node.js, browser, C++, Python, Arduino",
  "main": "index.js",
  "directories": {
    "example": "examples",
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "build:addon": "ln -sf binding.gyp.no-auto binding.gyp && node-gyp rebuild && rm binding.gyp",
    "build:browser": "./node_modules/.bin/webpack --stats-error-details",
    "build:doc": "node scripts/build-docs.js",
    "check:links": "node scripts/check-links.js",
    "test": "npm run test:adapter && npm run test:subscriptions && npm run test:examples && npm run test:reconnect && npm run test:agent && npm run test:client && npm run test:persistor && npm run test:lifecycle && npm run test:legacy-runtime && npm run test:production",
    "test:adapter": "./node_modules/.bin/mocha tests/adapter/*.js --exit",
    "test:native": "./node_modules/.bin/mocha tests/native/*.js --exit",
    "test:reconnect": "./node_modules/.bin/mocha tests/reconnect/*.spec.js --exit",
    "test:subscriptions": "./node_modules/.bin/mocha tests/subscriptions/*.spec.js --exit",
    "test:examples": "./node_modules/.bin/mocha tests/examples/*.spec.js --exit",
    "test:agent": "tests/agent/test.sh",
    "test:client": "tests/client/test.sh",
    "test:performance": "tests/performance/test.sh",
    "test:persistor": "./node_modules/.bin/mocha tests/persistor/*.js --timeout 30000 --exit",
    "test:lifecycle": "./node_modules/.bin/mocha tests/lifecycle/*.js --timeout 30000 --exit",
    "test:legacy-runtime": "tests/legacy-runtime/test.sh",
    "test:production": "./node_modules/.bin/mocha tests/production/lifeCycleTest.js --timeout 30000 --exit && tests/production/test.sh"
  },
  "bin": {
    "vrpc-agent-js": "./vrpc/vrpc-agent-js"
  },
  "keywords": [
    "nodejs",
    "javascript",
    "rpc",
    "mqtt",
    "remote objects",
    "remote procedure call",
    "mqtt-rpc",
    "iot",
    "edge-to-cloud",
    "events",
    "microservices",
    "browser",
    "react",
    "arduino",
    "esp32",
    "python",
    "c++"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/heisenware/vrpc-js.git"
  },
  "author": "Dr. Burkhard Heisen <burkhard.heisen@heisenware.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/heisenware/vrpc-js/issues"
  },
  "homepage": "https://vrpc.io",
  "devDependencies": {
    "@heisenware/storage": "^3.0.2",
    "assert": "^2.1.0",
    "chai": "^4.3.10",
    "crypto-browserify": "^3.12.1",
    "dockerode": "^5.0.1",
    "fs-extra": "^11.3.1",
    "jsdoc-to-markdown": "^9.1.3",
    "mocha": "^11.8.0",
    "mqtt-packet": "^9.0.2",
    "os-browserify": "^0.3.0",
    "sinon": "^21.0.0",
    "stream-browserify": "^3.0.0",
    "url": "^0.11.0",
    "util": "^0.12.5",
    "webpack": "^5.102.0",
    "webpack-cli": "^7.2.3"
  },
  "files": [
    "vrpc/",
    "browser/",
    "binding.gyp.no-auto"
  ],
  "browser": "./browser/vrpc.js",
  "dependencies": {
    "ajv": "^8.17.1",
    "argparse": "^2.0.1",
    "buffer": "^6.0.3",
    "caller": "^1.1.0",
    "json-stringify-safe": "^5.0.1",
    "mqtt": "^5.16.0",
    "nanoid": "^3.3.8",
    "process": "^0.11.10"
  },
  "peerDependencies": {
    "@heisenware/storage": "^1.2.2 || ^2.0.0 || ^3.0.0"
  },
  "peerDependenciesMeta": {
    "@heisenware/storage": {
      "optional": true
    }
  }
}
